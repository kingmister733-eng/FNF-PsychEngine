<?xml version="1.0" encoding="utf-8"?>
<project>
	<!-- _________________________ Application Settings _________________________ -->
	<app title="Psych Slice Mobile" file="PsychEngine" packageName="com.custom.psychslice" package="com.custom.psychslice" main="Main" version="1.0.0" company="YourName" />
	<app preloader="flixel.system.FlxPreloader" />

	<!--Switch code to compiled code-->
	<set name="BUILD_DIR" value="export" />

	<window width="1280" height="720" fps="60" background="#000000" hardware="true" vsync="false" />
	<window orientation="landscape" fullscreen="true" if="mobile" />
	<window resizable="true" unless="mobile" />

	<!-- ____________________________ Paths Settings ____________________________ -->
	<source path="source" />
	<assets path="assets" rename="assets" />

	<!-- _______________________________ Libraries ______________________________ -->
	<haxelib name="flixel" />
	<haxelib name="flixel-addons" />
	<haxelib name="flixel-ui" />
	<haxelib name="openfl" />
	<haxelib name="lime" />
	<haxelib name="hscript-iris" />
	<haxelib name="tjson" />
	<haxelib name="flxanimate" />

	<!-- ______________________________ Android _________________________________ -->
	<config:android permission="android.permission.READ_EXTERNAL_STORAGE" />
	<config:android permission="android.permission.WRITE_EXTERNAL_STORAGE" />
	<config:android permission="android.permission.VIBRATE" />
	<config:android permission="android.permission.INTERNET" />
</project>